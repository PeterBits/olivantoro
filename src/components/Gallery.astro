---
import { Picture } from 'astro:assets';
import gallery1 from '../assets/gallery-1.jpg';
import gallery2 from '../assets/gallery-2.jpg';
import gallery3 from '../assets/gallery-3.jpg';
import gallery4 from '../assets/gallery-4.jpg';
import gallery5 from '../assets/gallery-5.jpg';
import gallery6 from '../assets/gallery-6.jpg';
import gallery7 from '../assets/gallery-7.jpg';

const GALLERY_IMAGES = [
  { src: gallery1, alt: 'Exterior de la autocaravana Olivantoro' },
  { src: gallery2, alt: 'Vista de la autocaravana Olivantoro' },
  { src: gallery3, alt: 'Interior de la autocaravana Olivantoro' },
  { src: gallery4, alt: 'Zona de descanso de la autocaravana' },
  { src: gallery5, alt: 'Cocina equipada de la autocaravana' },
  { src: gallery6, alt: 'Comedor y salón de la autocaravana' },
  { src: gallery7, alt: 'Detalle del equipamiento interior' },
];
---

<section class="gallery section">
  <div class="gallery__inner">
    <header class="gallery__header">
      <span class="label-md gallery__label">Galería</span>
      <h2 class="display-md">La autocaravana, por dentro y por fuera.</h2>
    </header>
    <div class="gallery__grid">
      {GALLERY_IMAGES.map(({ src, alt }) => (
        <figure class="gallery__item">
          <Picture
            src={src}
            formats={['avif', 'webp']}
            widths={[400, 800, 1200]}
            sizes="(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 600px"
            alt={alt}
            class="gallery__img"
            loading="lazy"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery { background: var(--surface); }

  .gallery__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .gallery__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 42ch;
  }

  .gallery__label { color: var(--tertiary); }

  .gallery__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .gallery__item {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
  }

  .gallery__item picture {
    display: contents;
  }
  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 768px) {
    .gallery__grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }
</style>
